# CA Desk: security and caching headers. Netlify reads this file on every deploy, including drag-and-drop.
# The app may be shown inside other sites (e.g. a grading platform's preview). To forbid that later,
# add "X-Frame-Options: DENY" below and "frame-ancestors 'none';" to the Content-Security-Policy.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; worker-src 'self' blob:; manifest-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'

# The app itself: always check for a newer version
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/app.js
  Cache-Control: public, max-age=0, must-revalidate
/styles.css
  Cache-Control: public, max-age=0, must-revalidate
/config.js
  Cache-Control: public, max-age=0, must-revalidate

# The service worker must never be cached, or updates stop reaching phones
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

# Bundled libraries and icons change rarely
/lib/*
  Cache-Control: public, max-age=604800
/icons/*
  Cache-Control: public, max-age=604800
